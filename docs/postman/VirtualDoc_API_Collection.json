{
  "info": {
    "name": "VirtualDoc API Collection",
    "description": "Complete API collection for VirtualDoc Healthcare Platform - Includes Auth, User, and Patient Services",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    {
      "key": "auth_service_url",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "user_service_url",
      "value": "http://localhost:3002",
      "type": "string"
    },
    {
      "key": "patient_service_url",
      "value": "http://localhost:3003",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "patient_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication Service",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_service_url}}/health",
              "host": ["{{auth_service_url}}"],
              "path": ["health"]
            },
            "description": "Check if the auth service is running"
          },
          "response": []
        },
        {
          "name": "Universal Admin Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data) {",
                  "        pm.collectionVariables.set('user_id', jsonData.data.user.id);",
                  "        console.log('User created:', jsonData.data.user.email);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@virtualdoc.com\",\n  \"password\": \"SecurePass123!\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+1234567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{auth_service_url}}/api/admin/auth/signup",
              "host": ["{{auth_service_url}}"],
              "path": ["api", "admin", "auth", "signup"]
            },
            "description": "Create a new Universal Admin account"
          },
          "response": []
        },
        {
          "name": "Universal Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data.tokens) {",
                  "        pm.collectionVariables.set('access_token', jsonData.data.tokens.accessToken);",
                  "        pm.collectionVariables.set('refresh_token', jsonData.data.tokens.refreshToken);",
                  "        pm.collectionVariables.set('user_id', jsonData.data.user.id);",
                  "        console.log('Login successful! Tokens saved.');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@virtualdoc.com\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{auth_service_url}}/api/admin/auth/login",
              "host": ["{{auth_service_url}}"],
              "path": ["api", "admin", "auth", "login"]
            },
            "description": "Authenticate Universal Admin and receive access tokens"
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data && jsonData.data.otp) {",
                  "        pm.collectionVariables.set('reset_otp', jsonData.data.otp);",
                  "        console.log('OTP received:', jsonData.data.otp);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@virtualdoc.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{auth_service_url}}/api/admin/auth/forgot-password",
              "host": ["{{auth_service_url}}"],
              "path": ["api", "admin", "auth", "forgot-password"]
            },
            "description": "Request password reset OTP. In development, OTP is returned in response and logged to console."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@virtualdoc.com\",\n  \"otp\": \"{{reset_otp}}\",\n  \"newPassword\": \"NewSecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{auth_service_url}}/api/admin/auth/reset-password",
              "host": ["{{auth_service_url}}"],
              "path": ["api", "admin", "auth", "reset-password"]
            },
            "description": "Reset password using OTP received from forgot password"
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('access_token', '');",
                  "    pm.collectionVariables.set('refresh_token', '');",
                  "    console.log('Logged out successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{auth_service_url}}/api/admin/auth/logout",
              "host": ["{{auth_service_url}}"],
              "path": ["api", "admin", "auth", "logout"]
            },
            "description": "Logout and revoke all tokens"
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints for Universal Admin"
    },
