                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{user_service_url}}/api/users/{{user_id}}",
              "host": ["{{user_service_url}}"],
              "path": ["api", "users", "{{user_id}}"]
            },
            "description": "Get user by ID (own profile or admin access required)"
          },
          "response": []
