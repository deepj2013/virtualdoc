{
  "info": {
    "name": "VirtualDoc API Collection",
    "description": "Complete API collection for VirtualDoc Healthcare Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Check if the auth service is running"
          },
          "response": []
        },
        {
          "name": "Universal Admin Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data) {",
                  "        pm.collectionVariables.set('user_id', jsonData.data.user.id);",
                  "        console.log('User created:', jsonData.data.user.email);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@virtualdoc.com\",\n  \"password\": \"SecurePass123!\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+1234567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/auth/signup",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "auth", "signup"]
            },
            "description": "Create a new Universal Admin account"
          },
          "response": []
        },
        {
          "name": "Universal Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data.tokens) {",
                  "        pm.collectionVariables.set('access_token', jsonData.data.tokens.accessToken);",
                  "        pm.collectionVariables.set('refresh_token', jsonData.data.tokens.refreshToken);",
                  "        console.log('Login successful! Tokens saved.');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@virtualdoc.com\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "auth", "login"]
            },
            "description": "Authenticate Universal Admin and receive access tokens"
          },
          "response": []
        },
        {
          "name": "Refresh Token (Future)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{refresh_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "auth", "refresh"]
            },
            "description": "Refresh access token using refresh token (To be implemented)"
          },
          "response": []
        },
        {
          "name": "Logout (Future)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "auth", "logout"]
            },
            "description": "Logout and revoke tokens (To be implemented)"
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints for Universal Admin"
    },
    {
      "name": "Admin Profile (Future)",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "profile"]
            },
            "description": "Get admin profile (To be implemented)"
          },
          "response": []
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+1234567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "profile"]
            },
            "description": "Update admin profile (To be implemented)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Password Management (Future)",
      "item": [
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@virtualdoc.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "auth", "forgot-password"]
            },
            "description": "Request password reset (To be implemented)"
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"reset-token\",\n  \"password\": \"NewSecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "auth", "reset-password"]
            },
            "description": "Reset password with token (To be implemented)"
          },
          "response": []
        }
      ]
    }
  ]
}

