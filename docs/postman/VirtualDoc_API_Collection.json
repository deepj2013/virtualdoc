              "mode": "raw",
              "raw": "{\n  \"language\": \"en\",\n  \"timezone\": \"America/New_York\",\n  \"dateFormat\": \"MM/DD/YYYY\",\n  \"timeFormat\": \"12h\",\n  \"theme\": \"dark\",\n  \"notifications\": {\n    \"email\": true,\n    \"sms\": false,\n    \"push\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{user_service_url}}/api/users/preferences",
              "host": ["{{user_service_url}}"],
              "path": ["api", "users", "preferences"]
            },
            "description": "Update user preferences"
          },
          "response": []
