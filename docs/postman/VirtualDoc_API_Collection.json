        {
          "name": "Search Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{user_service_url}}/api/users/search?search=john&page=1&limit=20",
              "host": ["{{user_service_url}}"],
              "path": ["api", "users", "search"],
              "query": [
                {
                  "key": "search",
                  "value": "john",
                  "description": "Search term (name or email)"
                },
                {
                  "key": "role",
                  "value": "",
                  "description": "Filter by role",
                  "disabled": true
                },
                {
                  "key": "isActive",
                  "value": "true",
                  "description": "Filter by active status",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page"
                }
              ]
            },
            "description": "Search users (Admin only). Supports pagination and filtering."
          },
          "response": []
        }
      ],
      "description": "User management endpoints with profile and preferences"
    },
    {
      "name": "Patient Service",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{patient_service_url}}/health",
              "host": ["{{patient_service_url}}"],
              "path": ["health"]
            },
            "description": "Check if the patient service is running"
          },
          "response": []
        },
        {
          "name": "Create Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data.patient) {",
                  "        pm.collectionVariables.set('patient_id', jsonData.data.patient.id);",
                  "        console.log('Patient created:', jsonData.data.patient.patientNumber);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"gender\": \"female\",\n  \"bloodGroup\": \"O+\",\n  \"phone\": \"+1234567890\",\n  \"email\": \"jane.smith@example.com\",\n  \"addressLine1\": \"123 Main St\",\n  \"city\": \"New York\",\n  \"state\": \"NY\",\n  \"postalCode\": \"10001\",\n  \"country\": \"USA\",\n  \"emergencyContactName\": \"John Smith\",\n  \"emergencyContactPhone\": \"+1987654321\",\n  \"emergencyContactRelation\": \"spouse\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{patient_service_url}}/api/patients",
              "host": ["{{patient_service_url}}"],
              "path": ["api", "patients"]
            },
            "description": "Create a new patient. Patient number is auto-generated."
          },
          "response": []
        },
        {
          "name": "Get All Patients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{patient_service_url}}/api/patients?page=1&limit=20",
              "host": ["{{patient_service_url}}"],
              "path": ["api", "patients"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
