# VirtualDoc Environment Configuration
# Copy this file to .env and update with your values

# Application Configuration
NODE_ENV=development
API_BASE_URL=http://localhost
WEB_APP_URL=http://localhost:3000
PATIENT_PORTAL_URL=http://localhost:3001
ADMIN_DASHBOARD_URL=http://localhost:3002

# Database Configuration
POSTGRES_DB=virtualdoc
POSTGRES_USER=virtualdoc
POSTGRES_PASSWORD=virtualdoc123
DATABASE_URL=postgresql://virtualdoc:virtualdoc123@postgres:5432/virtualdoc

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=VirtualDoc <noreply@virtualdoc.health>

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# File Storage Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=virtualdoc
MINIO_SECRET_KEY=virtualdoc123
MINIO_BUCKET=virtualdoc-files

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://elasticsearch:9200

# AI Services Configuration
OPENAI_API_KEY=your-openai-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key
AZURE_AI_ENDPOINT=your-azure-ai-endpoint
AZURE_AI_KEY=your-azure-ai-key

# Payment Configuration (Stripe)
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Payment Configuration (PayPal)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Government Integration
ABHA_API_URL=https://api.abha.gov.in
ABHA_CLIENT_ID=your-abha-client-id
ABHA_CLIENT_SECRET=your-abha-client-secret

# Monitoring Configuration
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000

# Security Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/virtualdoc.log

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_TELEMEDICINE=true
ENABLE_BILLING=true
ENABLE_INVENTORY=true
ENABLE_REPORTING=true

# Development Configuration
DEBUG=false
HOT_RELOAD=true
MOCK_SERVICES=false

# Production Configuration (uncomment for production)
# NODE_ENV=production
# DATABASE_URL=postgresql://user:pass@prod-db:5432/virtualdoc
# REDIS_URL=redis://prod-redis:6379
# JWT_SECRET=your-production-jwt-secret
# JWT_REFRESH_SECRET=your-production-refresh-secret
